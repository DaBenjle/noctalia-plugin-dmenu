{
  "id": "dmenu",
  "name": "Dmenu Provider",
  "version": "2.0.0",
  "minNoctaliaVersion": "3.9.0",
  "author": "github.com/DaBenjle",
  "license": "MIT",
  "repository": "https://github.com/DaBenjle/noctalia-plugin-dmenu",
  "description": "A rofi-dmenu replacement that lets external scripts present arbitrary choices through a Noctalia panel.",
  "tags": ["Panel", "Productivity", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "resultFile": "/tmp/noctalia-dmenu-result",
      "defaultSeparator": "\n",
      "allowCustomInput": false,
      "showToastOnSelect": false,
      "resultFormat": "plain",
      "closeOnSelect": true,
      "customInputPrefix": "",
      "maxResults": 200
    }
  }
}
